s = input("Enter parentheses: ")

maximum = 0

for i in range(len(s)):

    left = 0
    right = 0

    for j in range(i, len(s)):

        if s[j] == '(':
            left += 1
        else:
            right += 1

        if right > left:
            break

        if left == right:
            length = j - i + 1
            maximum = max(maximum, length)

print(maximum)
