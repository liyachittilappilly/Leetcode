class Solution:
    def isRectangleOverlap(self, rec1: List[int], rec2: List[int]) -> bool:
        if (len(rec1)) and (len(rec2))==4:
            if max(rec1[0],rec2[0]) < min(rec2[2],rec1[2]):
                if max(rec1[1],rec2[1]) < min(rec2[3],rec1[3]):
                    return True
                else:
                    return False
            else:
                return False
        else:
            return False
